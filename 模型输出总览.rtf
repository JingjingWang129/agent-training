def quick_sort(arr):\
    """Sort an array using Quick Sort"""\
    \
    if len(arr) <= 1:  # Base case, return when length is less than or equal to one.\
        return arr\
    \
    pivot = arr[len(arr) // 2]  # Choose a random element as the pivot point.\
    left = [x for x in arr if x < pivot]  # Create two lists, one with elements smaller than and another larger than the pivot.\
    right = [x for x  in arr if x > pivot]\
    \
    return quick_sort(left) + [pivot] + quick_sort(right)   # Recursively call the same function on each sub-list until they are sorted.\
