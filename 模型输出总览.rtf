def timeit(func):\
    """Write a simple decorator\
that calculates the execution time\
of a function and prints out\
the elapsed time"""\
    \
    def wrapper(*args, **kwargs):\
        start = time.time()\
        result = func(*args, **kwargs)\
        end = time.time() - start\
        print("Elapsed time: \{:.2f\} seconds".format(end))\
        return result\
    \
    return wrapper\
