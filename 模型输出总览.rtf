def is_prime(n):\
    """Implement a function to check if n is a prime number"""\
    # Check for 0 and 1 as non-primes\
    if n <= 1:\
        return False\
    \
    # Check for even numbers greater than 2\
    if n > 2 and n % 2 == 0:\
        return False \
    \
    # Iterate over odd numbers up to the square root of n\
    for i in range(3, int(math.sqrt(n)) + 1, 2):\
        if n % i == 0:\
            return False\
        \
    return True\
